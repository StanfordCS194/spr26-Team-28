# Mixtape environment variables.
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# All variables are prefixed EXPO_PUBLIC_ so Expo inlines them into the client
# bundle. They are therefore NOT secret — protect your data with Supabase Row
# Level Security, not by hiding these values.

# --- Supabase (auth + database) ---
# From your Supabase project settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# --- Spotify (listening data) ---
# Client ID from https://developer.spotify.com/dashboard
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Optional: pin the exact redirect URI you registered in the Spotify dashboard.
# If unset, the app derives a stable URI from the app scheme
# ("mixtape://spotify-auth-callback"). Whatever value is used MUST be registered
# as a Redirect URI in your Spotify app settings.
# EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=mixtape://spotify-auth-callback
